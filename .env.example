# Environment Variables for Learnova LMS Development
# Copy to .env and adjust as needed

# Database
MOODLE_DATABASE_HOST=mariadb
MOODLE_DATABASE_USER=moodle
MOODLE_DATABASE_PASSWORD=moodle
MOODLE_DATABASE_NAME=moodle

# Cache
REDIS_HOST=redis

# Moodle Provisioning (leave MOODLE_REPO empty to use upstream)
# Set MOODLE_REPO to a git URL to clone a custom Moodle fork
MOODLE_REPO=
MOODLE_BRANCH=MOODLE_502_STABLE

# Initial Admin Account (change password after first login!)
ADMINUSER=admin
ADMINPASS=LearnovaLMS2026!
ADMINEMAIL=dev@lookmedia.id
