{{!
    @template local_learnova_course/grade_regrading

    Shared empty state for the grade panels when the course gradebook still
    needs recalculating and Moodle has queued that as a background task — no
    grade can be read until it finishes, so both panels say so rather than
    showing wrong or missing numbers.

    Context: none (static message).
}}
<div class="lm-empty">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16.023 9.348h4.992V4.356m-4.992 4.992l3.181-3.183a8.25 8.25 0 00-13.803 3.7M4.031 9.865v4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <div class="lm-empty__title">{{#str}}grade_regrading_title, local_learnova_course{{/str}}</div>
    <div class="lm-empty__desc">{{#str}}grade_regrading_desc, local_learnova_course{{/str}}</div>
</div>
