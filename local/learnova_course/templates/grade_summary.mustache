{{!
    @template local_learnova_course/grade_summary

    "Grade summary" tab of the Grades View panel — the class-level view: one row
    per graded activity with its type and the course-wide average, closed by the
    course total's average.

    Context: see \local_learnova_course\grade_summary::context().
}}
<div class="lm-card">
    <div class="lm-card__body">

        {{#regrading}}
        {{> local_learnova_course/grade_regrading }}
        {{/regrading}}

        {{^regrading}}
        {{#hasrows}}
        <div class="lm-table-wrap">
            <table class="lm-table table-reboot">
                <thead>
                    <tr>
                        <th>{{#str}}gs_col_item, local_learnova_course{{/str}}</th>
                        <th class="text-end">{{#str}}gs_col_average, local_learnova_course{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr>
                        <td>
                            <span class="lm-gitem-type">{{type}}</span>
                            <span class="lm-table__name">{{name}}</span>
                        </td>
                        <td class="text-end lm-grade-pct{{#empty}} is-empty{{/empty}}">{{average}}</td>
                    </tr>
                    {{/rows}}
                    {{#hastotal}}
                    <tr class="lm-grader__avg">
                        <td>{{#str}}gr_col_total, local_learnova_course{{/str}}</td>
                        <td class="text-end lm-grader__t{{#total.na}} is-na{{/total.na}}">{{total.display}}</td>
                    </tr>
                    {{/hastotal}}
                </tbody>
            </table>
        </div>
        {{/hasrows}}

        {{^hasrows}}
        <div class="lm-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div class="lm-empty__title">{{#str}}go_no_items_title, local_learnova_course{{/str}}</div>
            <div class="lm-empty__desc">{{#str}}go_no_items_desc, local_learnova_course{{/str}}</div>
        </div>
        {{/hasrows}}
        {{/regrading}}

    </div>
</div>
