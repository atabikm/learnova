{{!
    @template local_learnova_course/grades_tabs

    Body of both gradebook panels — "Grades View" and "Grades Setup". Each is the
    shared tabbed-embed component over one group of Moodle's own gradebook
    dropdown, so a tab is a real gradebook page rendered inside the panel.

    Context: see \local_learnova_course\grades::view_context() / setup_context().
}}
{{#hastabs}}
    {{> local_learnova_course/tabframe }}
{{/hastabs}}

{{^hastabs}}
<div class="lm-card">
    <div class="lm-card__body">
        <div class="lm-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div class="lm-empty__title">{{#str}}gt_none_title, local_learnova_course{{/str}}</div>
            <div class="lm-empty__desc">{{#str}}gt_none_desc, local_learnova_course{{/str}}</div>
        </div>
    </div>
</div>
{{/hastabs}}
