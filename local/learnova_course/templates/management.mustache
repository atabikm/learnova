{{!
    @template local_learnova_course/management

    Course Management page (learnova_course_management_v1 mockup): a 220px
    sidebar — "← Back to Course" pill on top, then the menu groups — next to a
    full-width main area with one panel per menu item. Panels are placeholders
    until each tool's own story lands; switching is client-side
    (local_learnova_course/management AMD), no reload.

    The global topbar/footer come from the theme layout and are not repeated
    here. Styles live in the theme's post.scss (.learnova-cm block).

    Context: see \local_learnova_course\management::context().
}}
<section class="learnova-cm">

    {{! ── Sidebar ─────────────────────────────────────────────────────── }}
    <aside class="learnova-cm__sidebar" data-region="cm-sidebar">
        <div class="learnova-cm__sb-section">
            <a class="learnova-cm__back" href="{{courseurl}}">
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
                {{#str}}management_back, local_learnova_course{{/str}}
            </a>
        </div>

        {{#groups}}
        {{#divider}}<div class="learnova-cm__sb-div"></div>{{/divider}}
        <div class="learnova-cm__sb-section">
            <div class="learnova-cm__sb-lbl">{{label}}</div>
            {{#items}}
            <button type="button"
                class="learnova-cm__sbi{{#active}} is-on{{/active}}{{#danger}} learnova-cm__sbi--danger{{/danger}}"
                data-cm-nav="{{key}}">
                {{{icon}}}
                <span class="learnova-cm__sbi-lbl">{{label}}</span>
                {{#tag}}<span class="learnova-cm__sbi-tag">{{tag}}</span>{{/tag}}
            </button>
            {{/items}}
        </div>
        {{/groups}}
    </aside>

    {{! ── Main area — one panel per menu item ─────────────────────────── }}
    <div class="learnova-cm__main" data-region="cm-main">
        {{#panels}}
        <div class="learnova-cm__panel{{#active}} is-show{{/active}}" data-cm-panel="{{key}}">
            <div class="learnova-cm__ph-course">{{coursename}}</div>
            <h1 class="learnova-cm__ph-title">{{label}}</h1>
            <p class="learnova-cm__ph-sub">{{subtitle}}</p>

            {{#isframe}}
            {{! Native course settings form, embedded chrome-less (clembed) and
                restyled as cards. The iframe is lazy-loaded and auto-sized by
                the management AMD module. }}
            <iframe class="learnova-cm__frame" title="{{label}}"
                data-region="cm-frame" data-src="{{frameurl}}" src="about:blank"
                scrolling="no"></iframe>
            {{/isframe}}

            {{#isparticipants}}
                {{#participants}}{{> local_learnova_course/participants }}{{/participants}}
            {{/isparticipants}}

            {{#isactivities}}
                {{#activities}}{{> local_learnova_course/activities }}{{/activities}}
            {{/isactivities}}

            {{#isreports}}
                {{#reports}}{{> local_learnova_course/reports }}{{/reports}}
            {{/isreports}}

            {{#isunenrol}}
                {{#unenrol}}{{> local_learnova_course/unenrol_me }}{{/unenrol}}
            {{/isunenrol}}

            {{#isresetcompletion}}
                {{#resetcompletion}}{{> local_learnova_course/reset_completion }}{{/resetcompletion}}
            {{/isresetcompletion}}

            {{#iscompetencies}}
                {{#competencies}}{{> local_learnova_course/competencies }}{{/competencies}}
            {{/iscompetencies}}

            {{#isbadges}}
                {{#badges}}{{> local_learnova_course/badges }}{{/badges}}
            {{/isbadges}}

            {{#isqbanks}}
                {{#qbanks}}{{> local_learnova_course/question_banks }}{{/qbanks}}
            {{/isqbanks}}

            {{#isgradestabs}}
                {{#gradestabs}}{{> local_learnova_course/grades_tabs }}{{/gradestabs}}
            {{/isgradestabs}}

            {{#iscoursereuse}}
                {{#coursereuse}}{{> local_learnova_course/course_reuse }}{{/coursereuse}}
            {{/iscoursereuse}}

            {{#isrecyclebin}}
                {{#recyclebin}}{{> local_learnova_course/recyclebin }}{{/recyclebin}}
            {{/isrecyclebin}}

            {{^isframe}}{{^isparticipants}}{{^isactivities}}{{^isreports}}{{^iscoursereuse}}{{^isrecyclebin}}{{^isgradestabs}}{{^isqbanks}}{{^isbadges}}{{^iscompetencies}}{{^isunenrol}}{{^isresetcompletion}}
            <div class="learnova-cm__card">
                <div class="learnova-cm__empty">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <div class="learnova-cm__empty-t">{{label}}</div>
                    <div class="learnova-cm__empty-d">{{#str}}management_empty, local_learnova_course{{/str}}</div>
                </div>
            </div>
            {{/isresetcompletion}}{{/isunenrol}}{{/iscompetencies}}{{/isbadges}}{{/isqbanks}}{{/isgradestabs}}{{/isrecyclebin}}{{/iscoursereuse}}{{/isreports}}{{/isactivities}}{{/isparticipants}}{{/isframe}}
        </div>
        {{/panels}}
    </div>
</section>
{{#js}}
require(['local_learnova_course/management'], function(CM) {
    CM.init();
});
{{/js}}
