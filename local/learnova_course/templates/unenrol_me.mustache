{{!
    @template local_learnova_course/unenrol_me

    Course Management "Unenrol Me" panel body — a warning card and the confirm
    button, one per enrolment method that actually allows self-unenrolment. The
    button hands off to Moodle's own unenrol page, which asks for confirmation
    again before anything is removed.

    Context: see \local_learnova_course\my_access::unenrol_context().
}}
<div class="lm-card">
    <div class="lm-card__body">

    {{#hasmethods}}
        <div class="lm-notice lm-notice--danger-outline">
            {{#str}}um_warning, local_learnova_course, {{coursename}}{{/str}}
        </div>
        {{! No Cancel here: leaving the panel is what cancelling is — the sidebar
            and "Back to Course" are both one click away, and Moodle's own
            unenrol page asks for confirmation again before removing anything. }}
        <div class="lm-btn-row">
            {{#methods}}
            <a class="lm-btn lm-btn--danger" href="{{url}}" data-action="um-confirm" data-name="{{name}}">
                {{#str}}um_confirm, local_learnova_course{{/str}}
            </a>
            {{/methods}}
        </div>
    {{/hasmethods}}

    {{^hasmethods}}
        <div class="lm-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div class="lm-empty__title">{{#str}}um_none_title, local_learnova_course{{/str}}</div>
            <div class="lm-empty__desc">{{#str}}um_none_desc, local_learnova_course{{/str}}</div>
        </div>
    {{/hasmethods}}

    </div>
</div>
