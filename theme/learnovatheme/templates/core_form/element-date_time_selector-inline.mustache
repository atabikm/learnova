{{!
    Override of core_form/element-date_time_selector-inline.

    The inline variant (a date used inside another group) gets the same
    separator removal as element-date_time_selector, so a date row is spaced by
    the flex `gap` wherever it appears. See that file for the rationale.
}}
{{< core_form/element-template-inline }}
    {{$element}}
        <div class="fdate_time_selector d-flex flex-wrap align-items-center">
        {{#element.elements}}
            {{{html}}}
        {{/element.elements}}
        </div>
    {{/element}}
{{/ core_form/element-template-inline }}
