{{!
    @template theme_learnovatheme/catalogue

    Course Catalogue page (course/index.php). Mirrors the
    learnova_course_catalogue_v1 mockup: a full-width teal hero with live
    stats + a search bar, then a boxed body with a filter sidebar and a course
    card grid. All data is real (built in classes/catalogue.php); fields with
    no data are simply omitted. Header/footer are the theme's own globals.

    Context:
        allurl          - course/index.php URL (clears all filters)
        stats[]         - {num, lbl, tone}
        hasactivefilters- bool; activefilters[] {label, url} chips; clearurl
        durations[]     - sidebar facets {name, count, checked, url}
        statuses[]      - sidebar facets {name, count, checked, url}
        categories[]    - sidebar facets {name, count, url, checked}
        formats[]       - sidebar facets {name, count}
        shown, total    - result counts
        hascards        - bool; cards[] - course cards
        haspagination   - bool; pages[] - {label, url, active}
}}
<section class="learnova-catalogue">

    {{! ── Hero ─────────────────────────────────────────────────────── }}
    <div class="learnova-catalogue__hero">
        <div class="learnova-catalogue__hero-deco1"></div>
        <div class="learnova-catalogue__hero-deco2"></div>
        <div class="learnova-catalogue__hero-inner">
            <div class="learnova-catalogue__hero-top">
                <div>
                    <h1 class="learnova-catalogue__hero-title">{{herotitle}}</h1>
                    <div class="learnova-catalogue__hero-sub">{{herosubtitle}}</div>
                </div>
                {{#hasstats}}
                <div class="learnova-catalogue__stats">
                    {{#stats}}
                        <div class="learnova-catalogue__stat">
                            <div class="learnova-catalogue__stat-num learnova-catalogue__stat-num--{{tone}}">{{num}}</div>
                            <div class="learnova-catalogue__stat-lbl">{{lbl}}</div>
                        </div>
                    {{/stats}}
                </div>
                {{/hasstats}}
            </div>
        </div>
        <div class="learnova-catalogue__searchbar">
            <form class="learnova-catalogue__search-inner" action="{{searchaction}}" method="get">
                {{#hiddenfilters}}<input type="hidden" name="{{name}}" value="{{value}}">{{/hiddenfilters}}
                <div class="learnova-catalogue__search-wrap">
                    <svg class="learnova-catalogue__search-ico" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"/></svg>
                    <input class="learnova-catalogue__search-input" type="text" name="search" value="{{searchvalue}}" placeholder="{{#str}}catalogue_search_ph, theme_learnovatheme{{/str}}"/>
                </div>
                <button class="learnova-catalogue__search-btn" type="submit">{{#str}}catalogue_search_btn, theme_learnovatheme{{/str}}</button>
            </form>
        </div>
    </div>

    {{! ── Body ─────────────────────────────────────────────────────── }}
    <div class="learnova-catalogue__body {{^hassidebar}}learnova-catalogue__body--nosidebar{{/hassidebar}}">

        {{#hassidebar}}
        {{! Filter sidebar }}
        <aside class="learnova-catalogue__sidebar">
            {{#hascategories}}
            <div class="learnova-filter-card">
                <div class="learnova-filter-card__head" data-lc-toggle>
                    <span class="learnova-filter-card__title">{{#str}}catalogue_filter_category, theme_learnovatheme{{/str}}</span>
                    <span class="learnova-filter-card__chevron is-open"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg></span>
                </div>
                <div class="learnova-filter-card__body">
                    {{#categories}}
                        <a class="learnova-filter-option" href="{{url}}">
                            <span class="learnova-filter-option__left">
                                <span class="learnova-filter-checkbox {{#checked}}is-checked{{/checked}}"></span>{{name}}
                            </span>
                            <span class="learnova-filter-count">{{count}}</span>
                        </a>
                    {{/categories}}
                </div>
            </div>
            {{/hascategories}}

            {{#hasdurations}}
            <div class="learnova-filter-card">
                <div class="learnova-filter-card__head" data-lc-toggle>
                    <span class="learnova-filter-card__title">{{#str}}catalogue_filter_duration, theme_learnovatheme{{/str}}</span>
                    <span class="learnova-filter-card__chevron is-open"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg></span>
                </div>
                <div class="learnova-filter-card__body">
                    {{#durations}}
                        <a class="learnova-filter-option" href="{{url}}">
                            <span class="learnova-filter-option__left">
                                <span class="learnova-filter-checkbox {{#checked}}is-checked{{/checked}}"></span>{{name}}
                            </span>
                            <span class="learnova-filter-count">{{count}}</span>
                        </a>
                    {{/durations}}
                </div>
            </div>
            {{/hasdurations}}

            {{#hasstatuses}}
            <div class="learnova-filter-card">
                <div class="learnova-filter-card__head" data-lc-toggle>
                    <span class="learnova-filter-card__title">{{#str}}catalogue_filter_status, theme_learnovatheme{{/str}}</span>
                    <span class="learnova-filter-card__chevron is-open"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg></span>
                </div>
                <div class="learnova-filter-card__body">
                    {{#statuses}}
                        <a class="learnova-filter-option" href="{{url}}">
                            <span class="learnova-filter-option__left">
                                <span class="learnova-filter-checkbox {{#checked}}is-checked{{/checked}}"></span>{{name}}
                            </span>
                            <span class="learnova-filter-count">{{count}}</span>
                        </a>
                    {{/statuses}}
                </div>
            </div>
            {{/hasstatuses}}
        </aside>
        {{/hassidebar}}

        {{! Course main }}
        <div class="learnova-catalogue__main">

            {{#hasactivefilters}}
            <div class="learnova-catalogue__active">
                {{#activefilters}}
                <span class="learnova-catalogue__chip">{{label}}
                    <a href="{{url}}" aria-label="{{#str}}catalogue_clear, theme_learnovatheme{{/str}}"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg></a>
                </span>
                {{/activefilters}}
                <a class="learnova-catalogue__clearall" href="{{clearurl}}">{{#str}}catalogue_clear_all, theme_learnovatheme{{/str}}</a>
            </div>
            {{/hasactivefilters}}

            <div class="learnova-catalogue__resultsbar">
                <div class="learnova-catalogue__count">{{#str}}catalogue_results, theme_learnovatheme, {"shown": {{shown}}, "total": {{total}} }{{/str}}</div>
                {{#hassort}}
                <div class="learnova-catalogue__sort">
                    <span class="learnova-catalogue__sort-lbl">{{#str}}catalogue_sort, theme_learnovatheme{{/str}}</span>
                    <select class="learnova-catalogue__sort-select" data-lc-sort>
                        {{#sortoptions}}
                            <option value="{{url}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                        {{/sortoptions}}
                    </select>
                </div>
                {{/hassort}}
            </div>

            {{#hascards}}
            <div class="learnova-catalogue__grid">
                {{#cards}}
                    <a class="learnova-course-card" href="{{url}}">
                        <div class="learnova-course-card__thumb {{^hasthumb}}learnova-course-card__thumb--empty{{/hasthumb}}" {{#hasthumb}}style="background-image:url('{{thumb}}')"{{/hasthumb}}>
                            <div class="learnova-course-card__thumb-ov"></div>
                        </div>
                        <div class="learnova-course-card__body">
                            <div class="learnova-course-card__tags">
                                {{#tags}}
                                    <span class="learnova-course-card__tag learnova-course-card__tag--{{tone}}">{{label}}</span>
                                {{/tags}}
                            </div>
                            <h3 class="learnova-course-card__title">{{title}}</h3>
                            {{#hasduration}}
                            <div class="learnova-course-card__meta">
                                <span><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a8 8 0 100 16A8 8 0 0010 2zm.75 4.75a.75.75 0 00-1.5 0v4l2.5 2.5a.75.75 0 001.06-1.06L10.75 10V6.75z"/></svg>{{duration}}</span>
                                {{#hasmodules}}<span><svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/></svg>{{modules}}</span>{{/hasmodules}}
                            </div>
                            {{/hasduration}}
                            {{^hasduration}}{{#hasmodules}}
                            <div class="learnova-course-card__meta">
                                <span><svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/></svg>{{modules}}</span>
                            </div>
                            {{/hasmodules}}{{/hasduration}}
                            {{#hasprogress}}
                            <div class="learnova-course-card__prog"><div class="learnova-course-card__prog-fill" style="width:{{progress}}%"></div></div>
                            {{/hasprogress}}
                            <div class="learnova-course-card__foot">
                                <span class="learnova-course-card__enroll">{{footnote}}</span>
                                <span class="learnova-course-card__btn">{{btnlabel}} <span>&rarr;</span></span>
                            </div>
                        </div>
                    </a>
                {{/cards}}
            </div>
            {{/hascards}}

            {{^hascards}}
            <div class="learnova-catalogue__empty">{{emptymsg}}</div>
            {{/hascards}}

            {{#haspagination}}
            <div class="learnova-catalogue__pagination">
                {{#pages}}
                    <a class="learnova-catalogue__page {{#active}}is-active{{/active}}" href="{{url}}">{{label}}</a>
                {{/pages}}
            </div>
            {{/haspagination}}

        </div>
    </div>
</section>
