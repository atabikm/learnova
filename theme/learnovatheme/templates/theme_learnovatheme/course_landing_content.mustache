{{!
    Course Content tab inner — module list + "Add section" button.
    Extracted from course_landing.mustache so the same markup can be
    re-rendered as a fragment (theme_learnovatheme_output_fragment_course_content)
    after +Add section / +Subsection, avoiding a full page reload.
    Context: {hasmodules, modules[], editing}. See course_landing.php::content_context().
}}
                {{#hasmodules}}
                    {{#modules}}
                    <div class="learnova-cl__module learnova-cl__module--{{status}}">
                        <div class="learnova-cl__mod-hd" data-cl-mod-toggle>
                            <div class="learnova-cl__mod-l">
                                {{#editing}}<input type="checkbox" class="learnova-cl__bchk" data-cl-bulk-item data-cl-type="section" data-cl-id="{{sectionid}}" data-cl-edstop aria-label="{{#str}}cl_bulk_select, theme_learnovatheme{{/str}}">{{/editing}}
                                <div class="learnova-cl__mod-n learnova-cl__mod-n--{{status}}">{{#is_done}}&#10003;{{/is_done}}{{^is_done}}{{num}}{{/is_done}}</div>
                                <div>
                                    <div class="learnova-cl__mod-title">{{name}}</div>
                                    <div class="learnova-cl__mod-sub">{{meta}}</div>
                                </div>
                            </div>
                            <div class="learnova-cl__mod-r">
                                {{#is_done}}<span class="learnova-cl__mod-badge learnova-cl__mod-badge--done">{{#str}}cl_status_done, theme_learnovatheme{{/str}}</span>{{/is_done}}
                                {{#is_progress}}<span class="learnova-cl__mod-badge learnova-cl__mod-badge--prog">{{#str}}cl_status_progress, theme_learnovatheme{{/str}}</span>{{/is_progress}}
                                {{#is_locked}}<span class="learnova-cl__mod-badge learnova-cl__mod-badge--lock">{{#str}}cl_status_locked, theme_learnovatheme{{/str}}</span>{{/is_locked}}

                                {{! Section edit controls — pencil + three-dot menu }}
                                {{#editing}}
                                <div class="learnova-cl__edctrls" data-cl-edstop>
                                    <button type="button" class="learnova-cl__ep" data-cl-action="rename" data-cl-rename-type="section" data-cl-rename-id="{{sectionid}}" data-cl-name="{{name}}" aria-label="{{#str}}cl_edit_rename, theme_learnovatheme{{/str}}">
                                        <svg viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
                                    </button>
                                    <div class="learnova-cl__menu-wrap">
                                        <button type="button" class="learnova-cl__menu-btn" data-cl-menu-toggle aria-label="{{#str}}cl_edit_menu_more, theme_learnovatheme{{/str}}">
                                            <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"/></svg>
                                        </button>
                                        <div class="learnova-cl__menu" data-region="cl-menu">
                                            <a class="learnova-cl__mi" href="{{permalink_url}}"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>{{#str}}cl_edit_menu_view, theme_learnovatheme{{/str}}</a>
                                            <button type="button" class="learnova-cl__mi" data-cl-action="edit" data-cl-edit-url="{{edit_url}}" data-cl-title="{{#str}}cl_edit_panel_section, theme_learnovatheme{{/str}}" data-cl-badge="{{#str}}cl_edit_panel_section_badge, theme_learnovatheme{{/str}}"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>{{#str}}cl_edit_menu_editsettings, theme_learnovatheme{{/str}}</button>
                                            <a class="learnova-cl__mi" href="{{highlight_url}}"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>{{#highlighted}}{{#str}}cl_edit_menu_unhighlight, theme_learnovatheme{{/str}}{{/highlighted}}{{^highlighted}}{{#str}}cl_edit_menu_highlight, theme_learnovatheme{{/str}}{{/highlighted}}</a>
                                            <button type="button" class="learnova-cl__mi" data-cl-action="duplicate" data-cl-type="section" data-cl-id="{{sectionid}}"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M7 9a2 2 0 012-2h6a2 2 0 012 2v6a2 2 0 01-2 2H9a2 2 0 01-2-2V9z"/><path d="M5 3a2 2 0 00-2 2v6a2 2 0 002 2V5h8a2 2 0 00-2-2H5z"/></svg>{{#str}}cl_edit_menu_duplicate, theme_learnovatheme{{/str}}</button>
                                            {{#hidden}}<button type="button" class="learnova-cl__mi" data-cl-action="show" data-cl-type="section" data-cl-id="{{sectionid}}"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>{{#str}}cl_edit_menu_show, theme_learnovatheme{{/str}}</button>{{/hidden}}
                                            {{^hidden}}<button type="button" class="learnova-cl__mi" data-cl-action="hide" data-cl-type="section" data-cl-id="{{sectionid}}"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M13.875 7.375A6.98 6.98 0 0116.542 10C15.268 14.057 11.478 17 7 17a6.97 6.97 0 01-2.29-.384M3.458 10A6.98 6.98 0 016.5 6.5m11.043 11.043l-14-14"/></svg>{{#str}}cl_edit_menu_hide, theme_learnovatheme{{/str}}</button>{{/hidden}}
                                            <button type="button" class="learnova-cl__mi" data-cl-action="move" data-cl-type="section" data-cl-id="{{sectionid}}" data-cl-name="{{name}}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 9 2 12 5 15"/><polyline points="9 5 12 2 15 5"/><polyline points="15 19 12 22 9 19"/><polyline points="19 9 22 12 19 15"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/></svg>{{#str}}cl_edit_menu_move, theme_learnovatheme{{/str}}</button>
                                            <a class="learnova-cl__mi" href="{{permalink_url}}"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 001.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd"/></svg>{{#str}}cl_edit_menu_permalink, theme_learnovatheme{{/str}}</a>
                                            <div class="learnova-cl__mi-sep"></div>
                                            <button type="button" class="learnova-cl__mi learnova-cl__mi--del" data-cl-action="delete" data-cl-type="section" data-cl-id="{{sectionid}}" data-cl-name="{{name}}"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>{{#str}}cl_edit_menu_delete, theme_learnovatheme{{/str}}</button>
                                        </div>
                                    </div>
                                </div>
                                {{/editing}}

                                <svg class="learnova-cl__mod-chev" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                            </div>
                        </div>
                        <div class="learnova-cl__acts"{{#editing}} data-cl-sectionid="{{sectionid}}"{{/editing}}>
                            {{#activities}}
                            {{> theme_learnovatheme/course_landing_activity }}
                            {{/activities}}

                            {{! ── Subsections — nested one level only ── }}
                            {{#subsections}}
                            <div class="learnova-cl__subsec">
                                <div class="learnova-cl__subsec-hd">
                                    <div class="learnova-cl__subsec-l">
                                        {{#editing}}<input type="checkbox" class="learnova-cl__bchk" data-cl-bulk-item data-cl-type="section" data-cl-id="{{sectionid}}" data-cl-edstop aria-label="{{#str}}cl_bulk_select, theme_learnovatheme{{/str}}">{{/editing}}
                                        <svg class="learnova-cl__subsec-ico" viewBox="0 0 20 20" fill="currentColor"><path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z"/></svg>
                                        <span class="learnova-cl__subsec-title">{{name}}</span>
                                    </div>
                                    {{#editing}}
                                    <div class="learnova-cl__edctrls" data-cl-edstop>
                                        <button type="button" class="learnova-cl__ep" data-cl-action="rename" data-cl-rename-type="section" data-cl-rename-id="{{sectionid}}" data-cl-name="{{name}}" aria-label="{{#str}}cl_edit_rename, theme_learnovatheme{{/str}}"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg></button>
                                        <div class="learnova-cl__menu-wrap">
                                            <button type="button" class="learnova-cl__menu-btn" data-cl-menu-toggle aria-label="{{#str}}cl_edit_menu_more, theme_learnovatheme{{/str}}"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"/></svg></button>
                                            <div class="learnova-cl__menu" data-region="cl-menu">
                                                <button type="button" class="learnova-cl__mi" data-cl-action="edit" data-cl-edit-url="{{edit_url}}" data-cl-title="{{#str}}cl_edit_panel_section, theme_learnovatheme{{/str}}" data-cl-badge="{{#str}}cl_edit_panel_section_badge, theme_learnovatheme{{/str}}"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>{{#str}}cl_edit_menu_editsettings, theme_learnovatheme{{/str}}</button>
                                                {{#hidden}}<button type="button" class="learnova-cl__mi" data-cl-action="show" data-cl-type="cm" data-cl-id="{{cmid}}"><svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>{{#str}}cl_edit_menu_show, theme_learnovatheme{{/str}}</button>{{/hidden}}
                                                {{^hidden}}<button type="button" class="learnova-cl__mi" data-cl-action="hide" data-cl-type="cm" data-cl-id="{{cmid}}"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M13.875 7.375A6.98 6.98 0 0116.542 10C15.268 14.057 11.478 17 7 17a6.97 6.97 0 01-2.29-.384M3.458 10A6.98 6.98 0 016.5 6.5m11.043 11.043l-14-14"/></svg>{{#str}}cl_edit_menu_hide, theme_learnovatheme{{/str}}</button>{{/hidden}}
                                                <div class="learnova-cl__mi-sep"></div>
                                                <button type="button" class="learnova-cl__mi learnova-cl__mi--del" data-cl-action="delete" data-cl-type="cm" data-cl-id="{{cmid}}" data-cl-name="{{name}}"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>{{#str}}cl_edit_menu_delete, theme_learnovatheme{{/str}}</button>
                                            </div>
                                        </div>
                                    </div>
                                    {{/editing}}
                                </div>
                                <div class="learnova-cl__subsec-acts"{{#editing}} data-cl-sectionid="{{sectionid}}"{{/editing}}>
                                    {{#activities}}
                                    {{> theme_learnovatheme/course_landing_activity }}
                                    {{/activities}}
                                </div>
                                {{! Subsection add — activity only, no further nesting }}
                                {{#editing}}
                                <button type="button" class="learnova-cl__addact learnova-cl__addact--solo" data-cl-addact data-cl-section="{{sectionnum}}">
                                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
                                    {{#str}}cl_edit_addact, theme_learnovatheme{{/str}}
                                </button>
                                {{/editing}}
                            </div>
                            {{/subsections}}

                            {{! ── Section-level add buttons ── }}
                            {{#editing}}
                            <div class="learnova-cl__addrow">
                                <button type="button" class="learnova-cl__addact" data-cl-addact data-cl-section="{{sectionnum}}">
                                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
                                    {{#str}}cl_edit_addact, theme_learnovatheme{{/str}}
                                </button>
                                <button type="button" class="learnova-cl__addsub" data-cl-addsub data-cl-sectionid="{{sectionid}}">
                                    <svg viewBox="0 0 20 20" fill="currentColor"><path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z"/></svg>
                                    {{#str}}cl_edit_subsection, theme_learnovatheme{{/str}}
                                </button>
                            </div>
                            {{/editing}}
                        </div>
                    </div>
                    {{/modules}}
                {{/hasmodules}}
                {{^hasmodules}}
                    <div class="learnova-cl__empty">{{#str}}cl_content_empty, theme_learnovatheme{{/str}}</div>
                {{/hasmodules}}

                {{! ── Add section — appends a new course section ── }}
                {{#editing}}
                <button type="button" class="learnova-cl__addsection" data-cl-addsection>
                    <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
                    {{#str}}cl_edit_addsection, theme_learnovatheme{{/str}}
                </button>
                {{/editing}}
