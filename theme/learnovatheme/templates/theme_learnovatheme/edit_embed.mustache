{{!
    @template theme_learnovatheme/edit_embed

    Chrome-less shell for the course-landing "Edit settings" panel.

    A trimmed copy of theme_boost/embedded, but the <body> attributes come from
    the `bodyattributes` context (computed with the extra `learnova-cl-embed`
    class in the drawers layout) rather than  output.body_attributes—
    add_body_class() can't run once the layout is already rendering, so the class
    has to be merged in at render time. post.scss (body.learnova-cl-embed)
    restyles the embedded Moodle form to match the sliding-panel mock.

    Context variables required for this template:
    * output - The core renderer for the page
    * bodyattributes - Attribute string for the <body> tag (incl. learnova-cl-embed)
    * headercontent - Activity header export (may be empty)
    * hasfakeblocks - true if there are fake blocks on this page
    * fakeblocks - HTML for the fake blocks
}}
{{{ output.doctype }}}
<html {{{ output.htmlattributes }}}>
<head>
    <title>{{{ output.page_title }}}</title>
    <link rel="shortcut icon" href="{{{ output.favicon }}}" />
    {{{ output.standard_head_html }}}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

{{{ output.standard_top_of_body_html }}}
<div id="page" {{#hasfakeblocks}}class="has-fake-blocks"{{/hasfakeblocks}}>
    {{#hasfakeblocks}}
        <div class="embedded-blocks">
            {{{ fakeblocks }}}
        </div>
    {{/hasfakeblocks}}
    <section class="embedded-main">
        {{#headercontent}}
            {{> core/activity_header }}
        {{/headercontent}}
        {{{ output.main_content }}}
    </section>
</div>
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{! Activity (modedit) forms: collapse the dual save buttons to a single }}
{{! "Save changes" (= Save and return to course) + Cancel, like the section }}
{{! form. Self-guards, so it's a no-op on section edit forms. }}
M.util.js_pending('theme_learnovatheme/embed_form');
require(['theme_learnovatheme/embed_form'], function(EmbedForm) {
  EmbedForm.init();
  M.util.js_complete('theme_learnovatheme/embed_form');
});
{{/js}}
