{{!
    @template theme_learnovatheme/featured

    Front-page "Featured Programs" section. 

    NOTE: data is currently dummy (built in layout/drawers.php). Swap for live
    program data once the source is wired up.

    Context:
        title          - section heading
        subtitle       - supporting line under the heading
        viewall_label  - header link text (blank hides the link)
        viewall_url    - header link href
        lead           - large lead card:
                         {url, thumb, category, title, meta, desc,
                          pills[]: {label, amber}, enrolled (optional)}
        cards[]        - compact cards:
                         {url, thumb, category, title, desc,
                          pills[]: {label, amber}
}}
<section class="learnova-featured" id="learnova-featured" aria-labelledby="learnova-featured-h">
    <div class="learnova-featured__inner">
    <div class="learnova-featured__boxed">
    <div class="learnova-featured__head">
        <div>
            <h2 class="learnova-featured__title" id="learnova-featured-h">{{title}}</h2>
            <p class="learnova-featured__sub">{{subtitle}}</p>
        </div>
        {{#viewall_label}}
            <a class="learnova-featured__viewall" href="{{viewall_url}}">{{viewall_label}} <span>&rarr;</span></a>
        {{/viewall_label}}
    </div>

    <div class="learnova-featured__grid">
        {{#lead}}
            <a class="learnova-feat-card learnova-feat-card--lg" href="{{url}}">
                <div class="learnova-feat-card__thumb learnova-feat-card__thumb--tall" style="background-image:url('{{thumb}}')">
                    <div class="learnova-feat-card__ov"></div>
                    <div class="learnova-feat-card__ov-cnt">
                        <span class="learnova-feat-card__cat">{{category}}</span>
                        <h3 class="learnova-feat-card__heading">{{title}}</h3>
                        {{#meta}}
                            <div class="learnova-feat-card__meta">
                                <svg viewBox="0 0 20 20" fill="currentColor"><path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/></svg>{{meta}}
                            </div>
                        {{/meta}}
                    </div>
                </div>
                <div class="learnova-feat-card__body">
                    <p class="learnova-feat-card__desc">{{desc}}</p>
                    <div class="learnova-feat-card__foot">
                        <div class="learnova-feat-card__pills">
                            {{#pills}}
                                <span class="learnova-feat-card__pill {{#amber}}learnova-feat-card__pill--amber{{/amber}}">{{label}}</span>
                            {{/pills}}
                        </div>
                        {{#enrolled}}
                            <span class="learnova-feat-card__enrolled">
                                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>{{enrolled}}
                            </span>
                        {{/enrolled}}
                    </div>
                </div>
            </a>
        {{/lead}}

        {{#cards}}
            <a class="learnova-feat-card" href="{{url}}">
                <div class="learnova-feat-card__thumb learnova-feat-card__thumb--short" style="background-image:url('{{thumb}}')">
                    <div class="learnova-feat-card__ov"></div>
                    <div class="learnova-feat-card__ov-cnt">
                        <span class="learnova-feat-card__cat">{{category}}</span>
                        <h3 class="learnova-feat-card__heading learnova-feat-card__heading--sm">{{title}}</h3>
                    </div>
                </div>
                <div class="learnova-feat-card__body">
                    <p class="learnova-feat-card__desc">{{desc}}</p>
                    <div class="learnova-feat-card__foot">
                        <div class="learnova-feat-card__pills">
                            {{#pills}}
                                <span class="learnova-feat-card__pill {{#amber}}learnova-feat-card__pill--amber{{/amber}}">{{label}}</span>
                            {{/pills}}
                        </div>
                    </div>
                </div>
            </a>
        {{/cards}}
    </div>
    </div>
    </div>
</section>
