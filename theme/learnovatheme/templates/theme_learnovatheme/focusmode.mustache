{{!
    @template theme_learnovatheme/focusmode

    Distraction-free "focus mode" chrome for activity view pages. Driven by
    real course data built in classes/focus_mode.php and layout/focusmode.php.
    Mirrors learnova_course_focus_mode_v2_10.html.

    The Show/Hide control is one logical toggle rendered in two places: "✕ Hide"
    lives in the sidebar header and disappears with the sidebar, "☰ Show" lives
    in the activity intro strip and only appears once the sidebar is gone. Which
    one is visible is decided by SCSS from the body state class, never by JS.

    All required Moodle core output hooks are preserved (top of body, after
    main region, end of body) so sessions, toasts and JS keep working.
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

{{{ output.standard_top_of_body_html }}}

<div class="fm-shell">

    {{! ══ TOP BAR ══ }}
    <div class="fm-topbar">
        <div class="fm-topbar-left">
            <a class="fm-back-btn" href="{{courseurl}}" title="{{#str}}fm_back_title, theme_learnovatheme{{/str}}">
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span class="fm-back-label">{{#str}}fm_back, theme_learnovatheme{{/str}}</span>
            </a>
        </div>

        <div class="fm-topbar-center">
            <div class="fm-topbar-course">
                <div class="fm-course-label{{#coursedone}} is-done{{/coursedone}}">
                    <span class="fm-course-dot"></span>
                    {{#coursedone}}{{#str}}fm_label_completed, theme_learnovatheme{{/str}}{{/coursedone}}
                    {{^coursedone}}{{#str}}fm_label_continuing, theme_learnovatheme{{/str}}{{/coursedone}}
                </div>
                <div class="fm-course-name">{{coursename}}</div>
            </div>
            {{#hasprogress}}
            <div class="fm-progress-wrap">
                <div class="fm-progress-track"><div class="fm-progress-fill" style="width:{{percent}}%;"></div></div>
                <div class="fm-progress-label">{{progresslabel}}</div>
            </div>
            {{/hasprogress}}
        </div>

        <div class="fm-topbar-right">
            <button type="button" class="fm-icon-btn" data-fm-action="dark-mode"
                    title="{{#str}}fm_darkmode, theme_learnovatheme{{/str}}"
                    aria-label="{{#str}}fm_darkmode, theme_learnovatheme{{/str}}">
                <svg class="fm-icon-moon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
                <svg class="fm-icon-sun" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1zm6 7a1 1 0 011-1v-1a1 1 0 10-2 0v1a1 1 0 011 1z" clip-rule="evenodd"/></svg>
            </button>
            <button type="button" class="fm-icon-btn fm-hide-mobile" data-fm-action="fullscreen"
                    title="{{#str}}fm_fullscreen, theme_learnovatheme{{/str}}"
                    aria-label="{{#str}}fm_fullscreen, theme_learnovatheme{{/str}}">
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 4a1 1 0 011-1h4a1 1 0 010 2H6.414l2.293 2.293a1 1 0 11-1.414 1.414L5 6.414V8a1 1 0 01-2 0V4zm9 1a1 1 0 010-2h4a1 1 0 011 1v4a1 1 0 01-2 0V6.414l-2.293 2.293a1 1 0 11-1.414-1.414L13.586 5H12zm-9 7a1 1 0 012 0v1.586l2.293-2.293a1 1 0 011.414 1.414L6.414 15H8a1 1 0 010 2H4a1 1 0 01-1-1v-4zm13-1a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 010-2h1.586l-2.293-2.293a1 1 0 011.414-1.414L15 13.586V12a1 1 0 011-1z" clip-rule="evenodd"/></svg>
            </button>
            {{#hassettings}}
            <a class="fm-icon-btn" href="{{settingsurl}}"
               title="{{#str}}fm_settings, theme_learnovatheme{{/str}}"
               aria-label="{{#str}}fm_settings, theme_learnovatheme{{/str}}">
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
            </a>
            {{/hassettings}}
            {{#useravatar}}
            <div class="fm-avatar">
                {{{useravatar}}}
            </div>
            {{/useravatar}}
        </div>
    </div>

    {{! ══ BODY ══ }}
    <div class="fm-body">

        {{! ══ SIDEBAR (table of contents) ══ }}
        <nav class="fm-sidebar" id="fmSidebar" aria-label="{{#str}}fm_toc_title, theme_learnovatheme{{/str}}">
            <div class="fm-sidebar-header">
                <div class="fm-sidebar-header-top">
                    <div class="fm-sidebar-heading">
                        <div class="fm-sidebar-title">{{#str}}fm_toc_title, theme_learnovatheme{{/str}}</div>
                        <div class="fm-sidebar-sub">{{tocsub}}</div>
                    </div>
                    <button type="button" class="fm-hide-btn" data-fm-action="hide-sidebar"
                            title="{{#str}}fm_hide_title, theme_learnovatheme{{/str}}">
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                        <span>{{#str}}fm_hide, theme_learnovatheme{{/str}}</span>
                    </button>
                </div>
                {{#hasprogress}}
                <div class="fm-sb-prog-row">
                    <div class="fm-sb-prog-track"><div class="fm-sb-prog-fill" style="width:{{percent}}%;"></div></div>
                    <div class="fm-sb-prog-label" data-label="{{#str}}fm_percent_completed, theme_learnovatheme{{/str}}">{{percent}}% {{#str}}fm_percent_completed, theme_learnovatheme{{/str}}</div>
                </div>
                {{/hasprogress}}
            </div>

            <div class="fm-toc">
                {{#modules}}
                <div class="fm-module{{#islocked}} fm-module--locked{{/islocked}}">
                    {{! A real <button>, not a div with tabindex: browsers only paint the
                        focus ring on a native button when focus arrived from the keyboard,
                        and Enter/Space come for free. }}
                    <button type="button" class="fm-module-header{{#iscurrent}} fm-module-header--current{{/iscurrent}}"
                            data-fm-action="toggle-module"
                            aria-expanded="{{#isopen}}true{{/isopen}}{{^isopen}}false{{/isopen}}">
                        <span class="fm-module-num{{#isdone}} done{{/isdone}}{{#iscurrent}} active{{/iscurrent}}{{#islocked}} locked{{/islocked}}" data-num="{{num}}">{{#isdone}}&#10003;{{/isdone}}{{^isdone}}{{num}}{{/isdone}}</span>
                        <span class="fm-module-info">
                            <span class="fm-module-name">{{name}}</span>
                            <span class="fm-module-meta">{{meta}}</span>
                            {{#hasrestriction}}
                            <span class="fm-module-restriction">{{restriction}}</span>
                            {{/hasrestriction}}
                        </span>
                        <svg class="fm-module-chev{{#isopen}} open{{/isopen}}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                    </button>
                    <div class="fm-activities"{{^isopen}} style="display:none;"{{/isopen}}>
                        {{#activities}}
                        <a class="fm-activity{{#iscurrent}} current{{/iscurrent}}{{#isdone}} done{{/isdone}}{{#islocked}} locked{{/islocked}}"{{#hasurl}} href="{{url}}"{{/hasurl}}{{#iscurrent}} aria-current="page"{{/iscurrent}} data-cmid="{{id}}">
                            <span class="fm-act-icon fm-act-icon--{{icontype}}"><img src="{{iconurl}}" alt="" width="16" height="16"></span>
                            <span class="fm-act-info">
                                <span class="fm-act-name{{#iscurrent}} current-name{{/iscurrent}}{{#isdone}} done-name{{/isdone}}">{{name}}</span>
                                {{#hasrestriction}}
                                <span class="fm-act-restriction">
                                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/></svg>
                                    {{restriction}}
                                </span>
                                {{/hasrestriction}}
                            </span>
                            {{#hasduration}}<span class="fm-act-dur">{{duration}}</span>{{/hasduration}}
                            <span class="fm-act-status">
                                {{#isdone}}<svg class="fm-act-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>{{/isdone}}
                                {{^isdone}}{{#iscurrent}}<span class="fm-act-dot"></span>{{/iscurrent}}{{/isdone}}
                                {{#islocked}}<svg class="fm-act-lock" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/></svg>{{/islocked}}
                            </span>
                        </a>
                        {{/activities}}
                    </div>
                </div>
                {{/modules}}
            </div>
        </nav>

        {{! Drawer backdrop — only rendered as a surface below the tablet breakpoint }}
        <div class="fm-backdrop" data-fm-action="hide-sidebar"></div>

        {{! ══ MAIN CONTENT ══ }}
        <div class="fm-content">

            {{! Activity intro strip — also the anchor for the "Show" toggle }}
            <div class="fm-intro">
                <div class="fm-intro-row">
                    <button type="button" class="fm-show-btn" data-fm-action="show-sidebar"
                            title="{{#str}}fm_show_title, theme_learnovatheme{{/str}}">
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/></svg>
                        <span>{{#str}}fm_show, theme_learnovatheme{{/str}}</span>
                    </button>
                    <div class="fm-intro-divider"></div>
                    <div class="fm-intro-icon fm-intro-icon--{{currenticontype}}">
                        <img src="{{currenticonurl}}" alt="" width="18" height="18">
                    </div>
                    <div class="fm-intro-main">
                        <div class="fm-breadcrumb">
                            <span class="fm-breadcrumb-link">{{currentsectionname}}</span>
                            <span class="fm-breadcrumb-sep">&middot;</span>
                            <span class="fm-breadcrumb-current">{{currentactivitysub}}</span>
                        </div>
                        <div class="fm-intro-titlerow">
                            <div class="fm-intro-title">{{currentname}}</div>
                            <div class="fm-intro-pill fm-intro-pill--{{typecategory}}">{{typelabel}}</div>
                            {{! Sits with the title and type pill, not with the right-hand
                                actions: it describes this activity, so it trails its name. }}
                            {{#hasdescription}}
                            <button type="button" class="fm-desc-toggle" data-fm-action="toggle-desc"
                                    aria-expanded="false" aria-controls="fmIntroDesc">
                                <span>{{#str}}fm_description, theme_learnovatheme{{/str}}</span>
                                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                            </button>
                            {{/hasdescription}}
                        </div>
                    </div>

                    <div class="fm-intro-actions">
                        {{#currentduration}}
                        <span class="fm-act-dur-label">
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a8 8 0 100 16A8 8 0 0010 2zm.75 4.75a.75.75 0 00-1.5 0v4l2.5 2.5a.75.75 0 001.06-1.06L10.75 10V6.75z"/></svg>
                            <span>{{currentduration}}</span>
                        </span>
                        {{/currentduration}}

                        {{#hasdiscussion}}
                        <button type="button" class="fm-pill-btn" data-fm-action="discussion"
                                aria-expanded="false" aria-controls="fmDiscPanel">
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.84 8.84 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7z" clip-rule="evenodd"/></svg>
                            <span class="fm-btn-label">{{#str}}fm_discussion, theme_learnovatheme{{/str}}</span>
                            {{! Reply-count badge — hidden at zero rather than shown as "0". }}
                            <span class="fm-badge{{^hasdiscussioncount}} fm-badge--empty{{/hasdiscussioncount}}"
                                  data-region="fm-disc-badge">{{discussioncount}}</span>
                        </button>
                        {{/hasdiscussion}}

                        {{! Teacher/Admin only — the list is empty for anyone core
                            does not grant a manage action to, which hides it. }}
                        {{#haskebab}}
                        <div class="fm-kebab-wrap">
                            <button type="button" class="fm-kebab-btn" data-fm-action="toggle-kebab"
                                    aria-expanded="false" aria-haspopup="true"
                                    aria-label="{{#str}}fm_manage_open, theme_learnovatheme{{/str}}">
                                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 6a2 2 0 100-4 2 2 0 000 4zM10 12a2 2 0 100-4 2 2 0 000 4zM10 18a2 2 0 100-4 2 2 0 000 4z"/></svg>
                            </button>
                            <div class="fm-kebab-menu" role="menu">
                                <div class="fm-kebab-eyebrow">{{#str}}fm_manage, theme_learnovatheme{{/str}}</div>
                                {{#kebab}}
                                {{#divider}}<div class="fm-kebab-divider"></div>{{/divider}}
                                <a class="fm-kebab-item" href="{{url}}" role="menuitem">{{text}}</a>
                                {{/kebab}}
                            </div>
                        </div>
                        {{/haskebab}}
                    </div>
                </div>

                {{#hasdescription}}
                {{! Expands in place — the strip grows and the content body below
                    it shrinks, so nothing floats over the activity. }}
                <div class="fm-intro-desc" id="fmIntroDesc">
                    <div class="fm-intro-desc-inner">{{{description}}}</div>
                </div>
                {{/hasdescription}}
            </div>

            {{! The PDF viewer owns its own scrolling — its toolbar has to stay put
                while the pages move under it — so the body around it must not
                scroll as well. }}
            <div class="fm-content-body{{#pdf}} fm-content-body--pdf{{/pdf}}" id="fmContentBody">
                {{#isdocument}}
                {{! Document mode — centered reading card for Page/Book/Assignment/Forum }}
                <div class="fm-document">
                    <div class="fm-doc-card">
                        {{> theme_learnovatheme/focusmode_document }}
                        {{{ output.course_content_header }}}
                        {{! output.main_content is a cut point, not markup: Moodle splices
                            the module's own output in here and errors out if the token is
                            missing. So when we have replaced the content (the forum card
                            list) the token still has to be emitted — it is hidden instead. }}
                        <div class="fm-native{{#suppressnative}} fm-native--replaced{{/suppressnative}}{{#book.nativetitles}} fm-native--booktitles{{/book.nativetitles}}{{#assign.hassubmissionform}} fm-native--inlinesubmit{{/assign.hassubmissionform}}">
                            {{{ output.main_content }}}
                        </div>
                        {{{ output.course_content_footer }}}

                        {{! Assignment: mod_assign's own submission form, inline and
                            collapsed by default. The form keeps its hidden action,
                            id and sesskey, so saving posts straight back into
                            mod_assign — this block only decides where it appears. }}
                        {{#assign.hassubmissionform}}
                        <div class="fm-sub-block" data-region="fm-sub-block">
                            <button type="button" class="fm-sub-head" data-fm-action="toggle-submission"
                                    aria-expanded="false" aria-controls="fmSubmissionBody">
                                <span>{{#str}}fm_assign_addsubmission, theme_learnovatheme{{/str}}</span>
                                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                            </button>
                            <div class="fm-sub-body" id="fmSubmissionBody">
                                {{{ assign.submissionform }}}
                            </div>
                        </div>
                        {{/assign.hassubmissionform}}

                        {{! Teacher/Admin note — sits under the submission area, per
                            the mockup. It stands in for Moodle's own Grading summary
                            table, which the SCSS hides so the two do not say the
                            same thing twice. Grading itself stays in Course
                            Management; this is only a way out to it. }}
                        {{#assign.isstaff}}
                        <div class="fm-teacher-note">
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
                            <div>
                                {{#str}}fm_assign_staff, theme_learnovatheme, {"submitted": "{{assign.submitted}}", "participants": "{{assign.participants}}", "needgrading": "{{assign.needgrading}}"}{{/str}}
                                <a href="{{assign.gradingurl}}">{{#str}}fm_assign_grading, theme_learnovatheme{{/str}} &rarr;</a>
                            </div>
                        </div>
                        {{/assign.isstaff}}

                        {{! Print trails the chapter it prints, per the mockup. }}
                        {{#book.hasprint}}
                        <a class="fm-print-btn" href="{{book.printurl}}" target="_blank" rel="noopener">
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5 4a2 2 0 012-2h6a2 2 0 012 2v1h1a2 2 0 012 2v5a2 2 0 01-2 2h-1v1a2 2 0 01-2 2H7a2 2 0 01-2-2v-1H4a2 2 0 01-2-2V7a2 2 0 012-2h1V4zm2 1h6V4H7v1zm6 9H7v2h6v-2z" clip-rule="evenodd"/></svg>
                            <span>{{#str}}fm_book_print, theme_learnovatheme{{/str}}</span>
                        </a>
                        {{/book.hasprint}}
                    </div>
                </div>
                {{/isdocument}}
                {{#ismedia}}
                {{! Media mode — the player fills the width but keeps its own
                    proportions; .fm-media scrolls if it ends up taller. }}
                <div class="fm-media fm-media--{{mediakind}}"{{#mediafit}} data-region="fm-media-fit"{{/mediafit}}>
                    {{! SCORM runs in mod_scorm's own chrome-less player page, so it
                        is framed rather than inlined. The player keeps the SCORM
                        API, the tracking and its navigation; only its surroundings
                        are ours. The frame is built only once the learner asks —
                        loading the player writes a start-time track. }}
                    {{#scormplaying}}
                    {{#scormbrowse}}
                    <div class="fm-notice-strip">{{#str}}fm_scorm_browsenote, theme_learnovatheme{{/str}}</div>
                    {{/scormbrowse}}
                    <div class="fm-scorm-scale">
                        <iframe class="fm-scorm-frame" src="{{scormurl}}"
                                title="{{currentname}}"
                                {{#hasscormstage}}data-fm-w="{{scormstagew}}" data-fm-h="{{scormstageh}}"{{/hasscormstage}}
                                {{#hasscormratio}}data-fm-ratio="{{scormratio}}"
                                style="aspect-ratio: {{scormratio}};"{{/hasscormratio}}
                                allowfullscreen allow="autoplay; fullscreen"></iframe>
                    </div>
                    <div class="fm-scorm-exit">
                        <a class="fm-btn-ghost" href="{{scormexiturl}}">
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 3a1 1 0 011 1v12a1 1 0 11-2 0V4a1 1 0 011-1zm7.293 2.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H7a1 1 0 110-2h5.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                            {{#str}}fm_scorm_exit, theme_learnovatheme{{/str}}
                        </a>
                    </div>
                    {{/scormplaying}}

                    {{#scormentry}}
                    <div class="fm-scorm-entry">
                        <div class="fm-scorm-stats">
                            <div class="fm-status-item">
                                <span class="fm-status-key">{{#str}}noattemptsallowed, scorm{{/str}}</span>
                                <span class="fm-status-val">{{allowed}}</span>
                            </div>
                            <div class="fm-status-item">
                                <span class="fm-status-key">{{#str}}noattemptsmade, scorm{{/str}}</span>
                                <span class="fm-status-val">{{made}}</span>
                            </div>
                            <div class="fm-status-item">
                                <span class="fm-status-key">{{#str}}grademethod, scorm{{/str}}</span>
                                <span class="fm-status-val">{{grademethod}}</span>
                            </div>
                            <div class="fm-status-item">
                                <span class="fm-status-key">{{#str}}gradereported, scorm{{/str}}</span>
                                <span class="fm-status-val">{{reported}}</span>
                            </div>
                        </div>

                        {{#exceeded}}
                        <div class="fm-notice-strip fm-notice-strip--warn">{{#str}}exceededmaxattempts, scorm{{/str}}</div>
                        {{/exceeded}}

                        <div class="fm-scorm-actions">
                            {{#canenter}}
                            <a class="fm-amber-btn" href="{{enterurl}}">{{#str}}enter, scorm{{/str}}</a>
                            {{/canenter}}
                            {{#canpreview}}
                            <a class="fm-btn-ghost" href="{{previewurl}}">{{#str}}browse, scorm{{/str}}</a>
                            {{/canpreview}}
                            {{#candelete}}
                            <a class="fm-btn-danger" href="{{deleteurl}}">{{#str}}deleteallattempts, scorm{{/str}}</a>
                            {{/candelete}}
                        </div>
                    </div>
                    {{/scormentry}}

                    {{! ══ PDF VIEWER ══
                        The chrome is all here; only the page canvases are built by
                        theme_learnovatheme/focus_pdf, because they are rendering
                        output rather than structure. If PDF.js cannot load or the
                        document cannot be read, the module removes this block and
                        unhides core's own embed below, which is still in the DOM. }}
                    {{#pdf}}
                    {{! Shown only if the viewer gives up; core's own embed is
                        unhidden underneath it at the same time. }}
                    <div class="fm-notice-strip fm-notice-strip--warn fm-pdf-fallback"
                         data-region="fm-pdf-fallback" hidden>
                        {{#str}}fm_pdf_fallback, theme_learnovatheme{{/str}}
                    </div>
                    <div class="fm-pdf" data-region="fm-pdf"
                         data-url="{{url}}" data-lib="{{liburl}}"
                         data-worker="{{workerurl}}" data-fonts="{{fontsurl}}">
                        <div class="fm-pdf-toolbar">
                            <svg class="fm-pdf-fileicon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/></svg>
                            <span class="fm-pdf-name" title="{{filename}}">{{filename}}</span>

                            <span class="fm-pdf-count" aria-live="polite">
                                <span class="visually-hidden">{{#str}}fm_pdf_pagelabel, theme_learnovatheme{{/str}}</span>
                                <span data-region="fm-pdf-count">&mdash;</span>
                            </span>

                            <div class="fm-pdf-zoom">
                                <button type="button" class="fm-pdf-btn" data-fm-action="pdf-zoom-out"
                                        title="{{#str}}fm_pdf_zoomout, theme_learnovatheme{{/str}}"
                                        aria-label="{{#str}}fm_pdf_zoomout, theme_learnovatheme{{/str}}">
                                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5 10a1 1 0 011-1h8a1 1 0 110 2H6a1 1 0 01-1-1z" clip-rule="evenodd"/></svg>
                                </button>
                                <select class="fm-pdf-level" data-region="fm-pdf-zoom"
                                        aria-label="{{#str}}fm_pdf_zoom, theme_learnovatheme{{/str}}">
                                    <option value="width">{{#str}}fm_pdf_fitwidth, theme_learnovatheme{{/str}}</option>
                                    <option value="page">{{#str}}fm_pdf_fitpage, theme_learnovatheme{{/str}}</option>
                                    <option value="0.5">50%</option>
                                    <option value="0.75">75%</option>
                                    <option value="1">100%</option>
                                    <option value="1.25">125%</option>
                                    <option value="1.5">150%</option>
                                    <option value="2">200%</option>
                                </select>
                                <button type="button" class="fm-pdf-btn" data-fm-action="pdf-zoom-in"
                                        title="{{#str}}fm_pdf_zoomin, theme_learnovatheme{{/str}}"
                                        aria-label="{{#str}}fm_pdf_zoomin, theme_learnovatheme{{/str}}">
                                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"/></svg>
                                </button>
                            </div>

                            <a class="fm-pdf-btn" href="{{downloadurl}}"
                               title="{{#str}}fm_pdf_download, theme_learnovatheme{{/str}}"
                               aria-label="{{#str}}fm_pdf_download, theme_learnovatheme{{/str}}">
                                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v7.586l2.293-2.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 11.586V4a1 1 0 011-1zm-6 12a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1z" clip-rule="evenodd"/></svg>
                            </a>
                            <button type="button" class="fm-pdf-btn" data-fm-action="pdf-print"
                                    title="{{#str}}fm_pdf_print, theme_learnovatheme{{/str}}"
                                    aria-label="{{#str}}fm_pdf_print, theme_learnovatheme{{/str}}">
                                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5 4a2 2 0 012-2h6a2 2 0 012 2v1h1a2 2 0 012 2v5a2 2 0 01-2 2h-1v1a2 2 0 01-2 2H7a2 2 0 01-2-2v-1H4a2 2 0 01-2-2V7a2 2 0 012-2h1V4zm2 1h6V4H7v1zm6 9H7v2h6v-2z" clip-rule="evenodd"/></svg>
                            </button>
                        </div>

                        <div class="fm-pdf-scroll" data-region="fm-pdf-scroll">
                            <div class="fm-pdf-pages" data-region="fm-pdf-pages"></div>
                            <div class="fm-pdf-status" data-region="fm-pdf-status">
                                {{#str}}fm_pdf_loading, theme_learnovatheme{{/str}}
                            </div>
                        </div>
                    </div>
                    {{/pdf}}

                    {{{ output.course_content_header }}}
                    <div class="fm-native{{#suppressnative}} fm-native--replaced{{/suppressnative}}">
                        {{{ output.main_content }}}
                    </div>
                    {{{ output.course_content_footer }}}
                </div>
                {{/ismedia}}

                {{#isquiz}}
                {{! Quiz mode — mod_quiz's own attempt output in a reading-width
                    column. The questions, their info bars, the flag toggle,
                    "Clear my choice" and the Previous/Next page buttons are all
                    core's, so pagination still follows the quiz's own page-break
                    settings and every answer still posts to processattempt.php.
                    Only the indicator above is ours, and it is progress-only:
                    the controls stay at the foot of the questions. }}
                <div class="fm-quiz">
                    <div class="fm-quiz-inner">
                        {{#hasquizprogress}}
                        <div class="fm-qindicator">
                            <div class="fm-qpager">
                                {{#quizdots}}
                                <span class="fm-qpager-dot{{#isdone}} is-done{{/isdone}}{{#iscurrent}} is-current{{/iscurrent}}"
                                      title="{{#str}}fm_quiz_dot, theme_learnovatheme, {{number}}{{/str}}"
                                      aria-hidden="true"></span>
                                {{/quizdots}}
                                <span class="fm-qpager-label">{{quizpagelabel}}</span>
                            </div>
                        </div>
                        {{/hasquizprogress}}

                        {{{ output.course_content_header }}}
                        <div class="fm-native fm-quiz-native">
                            {{{ output.main_content }}}
                        </div>
                        {{{ output.course_content_footer }}}
                    </div>
                </div>
                {{/isquiz}}

                {{^isdocument}}
                {{^ismedia}}
                {{^isquiz}}
                <div class="fm-content-inner">
                    {{{ output.course_content_header }}}
                    {{{ output.main_content }}}
                    {{{ output.course_content_footer }}}
                </div>
                {{/isquiz}}
                {{/ismedia}}
                {{/isdocument}}
            </div>

            {{! ══ BOTTOM NAV ══ }}
            <div class="fm-nav-bar">
                {{#hasprev}}
                <div class="fm-nav-group">
                    <a class="fm-nav-btn fm-nav-prev" href="{{prevurl}}" title="{{prevname}}">
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                        <span>{{#str}}fm_prev, theme_learnovatheme{{/str}}</span>
                    </a>
                </div>
                {{/hasprev}}
                {{^hasprev}}<span class="fm-nav-spacer"></span>{{/hasprev}}

                <div class="fm-nav-center">
                    <div class="fm-status-slot">
                        <div class="fm-status-badge {{#iscurrentdone}}fm-status-badge--done done{{/iscurrentdone}}{{^iscurrentdone}}fm-status-badge--pending pending{{/iscurrentdone}}"
                             style="display:inline-flex;align-items:center;justify-content:center;gap:7px;">
                            {{#iscurrentdone}}
                            <svg class="fm-status-icon" width="15" height="15" style="width:15px;height:15px;min-width:15px;min-height:15px;max-width:15px;max-height:15px;flex-shrink:0;display:inline-block;" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            </svg>
                            <span>{{#str}}fm_status_done, theme_learnovatheme{{/str}}</span>
                            {{/iscurrentdone}}
                            {{^iscurrentdone}}
                            <svg class="fm-status-icon" width="15" height="15" style="width:15px;height:15px;min-width:15px;min-height:15px;max-width:15px;max-height:15px;flex-shrink:0;display:inline-block;" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <circle cx="10" cy="10" r="7"/>
                            </svg>
                            <span>{{#str}}fm_status_not_done, theme_learnovatheme{{/str}}</span>
                            {{/iscurrentdone}}
                        </div>
                    </div>

                    {{#hasnext}}
                    <a class="fm-next-preview" href="{{nexturl}}" title="{{nextname}}">
                        <div class="fm-next-info">
                            <div class="fm-next-label">{{#str}}fm_next_preview, theme_learnovatheme{{/str}}</div>
                            <div class="fm-next-name">{{nextname}}</div>
                        </div>
                        <svg class="fm-next-arr" width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
                    </a>
                    {{/hasnext}}
                </div>

                {{#hasnext}}
                <div class="fm-nav-group fm-nav-group--right">
                    <a class="fm-nav-btn fm-nav-next" href="{{nexturl}}" title="{{nextname}}">
                        <span>{{#str}}fm_next, theme_learnovatheme{{/str}}</span>
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
                    </a>
                </div>
                {{/hasnext}}
                {{^hasnext}}<span class="fm-nav-spacer"></span>{{/hasnext}}
            </div>
        </div>
    </div>

    {{! ══ ACTIVITY DISCUSSION (slide-over) ══
        A presentation of the same discussion engine the course landing tab uses
        (local_learnova_course), scoped to this activity — not a second data
        model. Slides in over the content on desktop/tablet, covers the screen on
        mobile; which one is a matter of SCSS alone. }}
    {{#hasdiscussion}}
    <div class="fm-disc-overlay" data-fm-action="discussion-close"></div>
    <aside class="fm-disc-panel" id="fmDiscPanel" data-region="fm-disc"
           data-courseid="{{discussion.courseid}}" data-cmid="{{discussion.cmid}}"
           aria-label="{{#str}}fm_disc_title, theme_learnovatheme{{/str}}">
        <div class="fm-disc-head">
            <div class="fm-disc-heading">
                <div class="fm-disc-title">{{#str}}fm_disc_title, theme_learnovatheme{{/str}}</div>
                <div class="fm-disc-sub">{{#str}}fm_disc_on, theme_learnovatheme, {{discussion.activity}}{{/str}}</div>
            </div>
            <button type="button" class="fm-disc-close" data-fm-action="discussion-close"
                    title="{{#str}}closebuttontitle, core{{/str}}"
                    aria-label="{{#str}}closebuttontitle, core{{/str}}">
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </button>
        </div>

        {{! The partial reads threads/hasthreads at the root of its context — the
            same shape the AJAX refresh renders it with — so it has to be entered
            through the discussion section, not from the level above it. }}
        <div class="fm-disc-body" data-region="fm-disc-threads">
            {{#discussion}}
            {{> theme_learnovatheme/focusmode_threads }}
            {{/discussion}}
        </div>

        {{#discussion.canpost}}
        <form class="fm-disc-new" data-region="fm-disc-form" data-parentid="0">
            {{! Shown only while a topic is being replied to; the same composer
                otherwise starts a new one. }}
            <div class="fm-disc-replyctx" data-region="fm-disc-replyctx" hidden>
                <span>{{#str}}fm_disc_replyingto, theme_learnovatheme{{/str}} <strong data-region="fm-disc-replyname"></strong></span>
                <button type="button" class="fm-disc-replycancel" data-fm-action="disc-reply-cancel">{{#str}}cancel, core{{/str}}</button>
            </div>
            <label class="visually-hidden" for="fmDiscInput">{{#str}}fm_disc_placeholder, theme_learnovatheme{{/str}}</label>
            <textarea class="fm-disc-input" id="fmDiscInput" data-region="fm-disc-input"
                      maxlength="2000" placeholder="{{#str}}fm_disc_placeholder, theme_learnovatheme{{/str}}"></textarea>
            <div class="fm-disc-error" data-region="fm-disc-error" hidden></div>
            <button type="submit" class="fm-disc-post" data-action="disc-post">{{#str}}fm_disc_post, theme_learnovatheme{{/str}}</button>
        </form>
        {{/discussion.canpost}}
        {{^discussion.canpost}}
        <div class="fm-disc-readonly">{{#str}}fm_disc_readonly, theme_learnovatheme{{/str}}</div>
        {{/discussion.canpost}}
    </aside>
    {{/hasdiscussion}}

    {{! Float toggle button when sidebar is collapsed }}
    <button type="button" class="fm-float-toggle" data-fm-action="show-sidebar"
            title="{{#str}}fm_show_title, theme_learnovatheme{{/str}}"
            aria-label="{{#str}}fm_show_title, theme_learnovatheme{{/str}}">
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/></svg>
    </button>
</div>

{{{ output.standard_after_main_region_html }}}
{{{ output.standard_end_of_body_html }}}

</body>
</html>
{{#js}}
{{! Bootstrap's own JS — dropdowns, tooltips, popovers, collapse — plus Boost's
    ARIA patches. Every Boost layout loads this; without it any markup an
    activity emits with data-bs-toggle is inert inside the focus chrome (the
    forum discussion's Settings menu was the first casualty). Boost's drawer is
    deliberately left out: this layout has no drawers of Boost's. }}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
    M.util.js_complete('theme_boost/loader');
});
require(['theme_learnovatheme/focus_mode'], function(FocusMode) {
    FocusMode.init();
});
{{#pdf}}
require(['theme_learnovatheme/focus_pdf'], function(FocusPdf) {
    FocusPdf.init();
});
{{/pdf}}
{{/js}}
